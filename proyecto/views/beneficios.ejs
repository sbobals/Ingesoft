<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simulador de Beneficios</title>
  <link rel="stylesheet" href="CSS/simulador.css">
</head>
<body>

  <div class="topbar-institucional">
  <div class="topbar-content">
    <div class="logo-placeholder">
      <img src="/logo.png" alt="UTFSM">
       UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
    </div>
    <div class="topbar-right">
      <a href="/">&#8592; Volver al inicio</a>
    </div>
  </div>
</div>

  <div class="content">
    <!-- HEADER L -->
    <div class="panel-header">
      <div class="role-icon">📋</div>
      <div class="panel-header-text">
        <h2>Simulador de Beneficios</h2>
        <p>Visualiza las diferentes becas en tu arancel</p>
      </div>
    </div>
    
    <div class="filter-bar">
      <label style="font-weight: 600; color: #111827; font-size: 14px;">Carrera a simular:</label>
      <select id="carrera-select" onchange="actualizarSimulacion()">
        <% carreras.forEach(c => { %>
          <option value="<%= c.arancel %>"><%= c.nombre %> - $<%= Number(c.arancel).toLocaleString('es-CL') %></option>
        <% }) %>
      </select>
    </div>
    
    <div class="metrics">
      <div class="metric-card neutral">
        <div class="metric-label">Arancel Anual (Base)</div>
        <div class="metric-value" id="display-base">$0</div>
      </div>
      <div class="metric-card purple">
        <div class="metric-label">Ahorro Simulado</div>
        <div class="metric-value" id="display-descuento" style="color: #7C3AED;">$0</div>
      </div>
      <div class="metric-card success">
        <div class="metric-label">Costo Proyectado</div>
        <div class="metric-value" id="display-proyectado" style="color: #16A34A;">$0</div>
      </div>
    </div>

    <h2 style="margin-bottom: 1rem; font-size: 16px;">Selecciona beneficios para evaluar financiamiento</h2>

    <div class="grid">
      <% if (beneficios && beneficios.length > 0) { %>
        <% beneficios.forEach(b => { %>
          <label class="card">
            <div class="card-header">
              <input type="checkbox" class="beneficio-chk" value="<%= b.cobertura %>" onchange="actualizarSimulacion()">
              <span class="card-nombre"><%= b.tipo %></span>
            </div>
            <div class="card-body">
              <div class="card-row">
                <span style="color:#6B7280;">Cobertura:</span>
                <span style="font-weight:600;">$<%= Number(b.cobertura).toLocaleString('es-CL') %></span>
              </div>
              <div class="card-row">
                <span style="color:#6B7280;">Vigencia hasta:</span>
                <span style="font-weight:600;"><%= b.vigencia %></span>
              </div>
            </div>
          </label>
        <% }) %>
      <% } %>
    </div>
  </div>
  <div class="volver-container">
      <a href="javascript:history.back()" class="btn-volver">
          ← Volver atrás
      </a>
  </div>
  <script>
    function actualizarSimulacion() {
      // 1. Obtener el arancel base del selector
      const selector = document.getElementById('carrera-select');
      const arancelBase = parseInt(selector.value);
      
      // 2. Sumar la cobertura de los beneficios marcados
      let ahorro = 0;
      document.querySelectorAll('.beneficio-chk:checked').forEach(chk => {
        ahorro += parseInt(chk.value);
      });

      // 3. Calcular el costo final proyectado
      const proyectado = Math.max(0, arancelBase - ahorro);

      // 4. Actualizar la pantalla con formato de pesos
      document.getElementById('display-base').innerText = '$' + arancelBase.toLocaleString('es-CL');
      document.getElementById('display-descuento').innerText = '$' + ahorro.toLocaleString('es-CL');
      document.getElementById('display-proyectado').innerText = '$' + proyectado.toLocaleString('es-CL');
    }

    // Ejecutamos la función al cargar la página para que inicie con los valores correctos
    window.onload = actualizarSimulacion;
  </script>
</body>
</html>
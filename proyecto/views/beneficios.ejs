<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Beneficios Asignados</title>
  <link rel="stylesheet" href="CSS/simulador.css">
</head>
<body>

  <div class="topbar-institucional">
  <div class="topbar-content">
    <div class="logo-placeholder">
      <img src="/logo.png" alt="UTFSM">
       UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
    </div>
    <div class="topbar-right">
      <a href="/">&#8592; Volver al inicio</a>
    </div>
  </div>
</div>

  <div class="content">
    <div class="panel-header">
      <div class="role-icon">🎓</div>
      <div class="panel-header-text">
        <h2>Simulador de Beneficios Asignados</h2>
        <p>Visualiza cómo tus becas y beneficios reducen tu arancel</p>
      </div>
    </div>
    
    <div class="filter-bar">
      <label style="font-weight: 600; color: #111827; font-size: 14px;">Arancel a evaluar:</label>
      <select id="carrera-select" onchange="actualizarValores()">
        <% carreras.forEach(c => { %>
          <option value="<%= c.arancel %>"><%= c.nombre %> - $<%= Number(c.arancel).toLocaleString('es-CL') %></option>
        <% }) %>
      </select>
    </div>
    
    <div class="metrics">
      <div class="metric-card neutral">
        <div class="metric-label">Arancel Anual (Base)</div>
        <div class="metric-value" id="display-base">$0</div>
      </div>
      <div class="metric-card purple">
        <div class="metric-label">Descuento por Beneficios</div>
        <div class="metric-value" id="display-descuento" style="color: #7C3AED;">$0</div>
      </div>
      <div class="metric-card success">
        <div class="metric-label">Costo Proyectado</div>
        <div class="metric-value" id="display-proyectado" style="color: #16A34A;">$0</div>
      </div>
    </div>

    <h2 style="margin-bottom: 1rem; font-size: 16px;">Tus beneficios actuales registrados en el sistema:</h2>

    <div class="grid">
      <% if (beneficios && beneficios.length > 0) { %>
        <% beneficios.forEach(b => { %>
          <div class="card" style="cursor: default; border-color: #D1D5DB;"> <div class="card-header">
              <span style="margin-right: 10px; font-size: 18px;">✅</span>
              <span class="card-nombre"><%= b.tipo %></span>
              <input type="hidden" class="beneficio-valor" value="<%= b.cobertura %>">
            </div>
            <div class="card-body">
              <div class="card-row">
                <span style="color:#6B7280;">Cobertura:</span>
                <span style="font-weight:600; color: #7C3AED;">$<%= Number(b.cobertura).toLocaleString('es-CL') %></span>
              </div>
              <div class="card-row">
                <span style="color:#6B7280;">Vigencia hasta:</span>
                <span style="font-weight:600;"><%= b.vigencia %></span>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: #6B7280; font-style: italic;">No tienes beneficios asignados actualmente.</p>
      <% } %>
    </div>
  </div>
  <div class="volver-container">
      <a href="javascript:history.back()" class="btn-volver">
          ← Volver atrás
      </a>
  </div>
  
  <script>
    function actualizarValores() {
      // 1. Obtener el arancel base del selector
      const selector = document.getElementById('carrera-select');
      const arancelBase = parseInt(selector.value);
      
      // 2. Sumar automáticamente TODOS los beneficios asignados que aparecen en pantalla
      let ahorro = 0;
      document.querySelectorAll('.beneficio-valor').forEach(inputHidden => {
        ahorro += parseInt(inputHidden.value);
      });

      // 3. Calcular el costo final proyectado (evitando que dé números negativos si la beca es mayor al arancel)
      const proyectado = Math.max(0, arancelBase - ahorro);

      // 4. Actualizar la pantalla con formato de pesos
      document.getElementById('display-base').innerText = '$' + arancelBase.toLocaleString('es-CL');
      document.getElementById('display-descuento').innerText = '$' + ahorro.toLocaleString('es-CL');
      document.getElementById('display-proyectado').innerText = '$' + proyectado.toLocaleString('es-CL');
    }

    // Ejecutamos la función apenas cargue la página para hacer el cálculo inmediato
    window.onload = actualizarValores;
  </script>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitud de Certificados — UTFSM</title>
    <link rel="stylesheet" href="/CSS/paneles.css">
    <link rel="stylesheet" href="/CSS/certificados.css">
</head>
<body>

<div class="topbar-institucional">
    <div class="topbar-content">
        <span class="logo-placeholder">
            <img src="/logo.png" alt="Logo USM"> UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
        </span>
        <div class="topbar-right">
            <a href="/mis-solicitudes">📋 Mis Solicitudes</a> &nbsp;|&nbsp;
            <a href="/estudiante">← Volver al Panel</a>
        </div>
    </div>
</div>

<div class="main-container">

    <div class="panel-header">
        <div class="role-icon student">
            📄
        </div>
        <div class="panel-header-text">
            <div class="role-tag student">
                CERTIFICADOS DIGITALES
            </div>
            <h2>Solicitud de Certificados</h2>
            <p>
                Selecciona el tipo de certificado e indica el motivo de tu solicitud. Será registrada con estado inicial <strong>PENDIENTE</strong>.
            </p>
        </div>
    </div>

    <% if (typeof mensaje !== 'undefined' && mensaje) { %>
        <div class="alerta <%= mensaje.tipo %>">
            <%= mensaje.texto %>
        </div>
    <% } %>

    <div class="form-card">
        <form method="POST" action="/certificados/solicitar">

            <label for="tipo_certificado">
                Tipo de certificado:
            </label>
            <select id="tipo_certificado" name="tipo_certificado" required>
                <option value="">Seleccione un certificado</option>
                <option value="Certificado de Alumno Regular">Certificado de Alumno Regular</option>
                <option value="Certificado de Arancel y Matrícula">Certificado de Arancel y Matrícula</option>
                <option value="Seguro de Práctica">Seguro de Práctica</option>
                <option value="Certificado de No Deuda Financiera">Certificado de No Deuda Financiera</option>
            </select>

            <label for="motivo">
                Motivo de la solicitud:
            </label>
            <textarea
                id="motivo"
                name="motivo"
                rows="4"
                placeholder="Ej: Trámite de renovación de pase escolar (TNE), postulación a beca municipal, práctica profesional..."
                required
            ></textarea>

            <div class="form-actions">
                <button type="submit" class="btn-enviar-solicitud">
                    Enviar Solicitud
                </button>
                <a href="/mis-solicitudes" class="btn-secundario-solicitud">
                    📋 Ver Estado de Mis Solicitudes
                </a>
            </div>

        </form>
    </div>

</div>

<div class="footer-portal">
    <hr>
    <p>© Universidad Técnica Federico Santa María</p>
</div>

</body>
</html>

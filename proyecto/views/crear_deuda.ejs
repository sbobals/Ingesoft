<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nueva Deuda</title>

  <!-- MISMO CSS -->
  <link rel="stylesheet" href="/CSS/paneles.css">

  <style>
    .form-container {
      max-width: 500px;
      margin: 0 auto;
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    label {
      display: block;
      margin-top: 15px;
      font-weight: bold;
    }

    input, select {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    .btn-submit {
      margin-top: 20px;
      width: 100%;
      padding: 12px;
      background: #1E3A8A;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
    }

    .btn-submit:hover {
      background: #3B5FC0;
    }

    .back {
      display: block;
      margin-top: 15px;
      text-align: center;
      text-decoration: none;
      color: #6B7280;
    }
  </style>
</head>

<body>

<!-- 🔵 TOPBAR -->
<div class="topbar-institucional">
  <div class="topbar-content">
    <span class="logo-placeholder">
      <img src="/logo.png" alt="Logo USM"> 
      UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
    </span>

    <div class="topbar-right">
      <a href="/deudas">⬅ Volver</a> |
    </div>
  </div>
</div>

<!-- CONTENIDO -->
<div class="main-container">

  <!-- HEADER -->
  <div class="panel-header">
    <div class="role-icon">➕</div>
    <div class="panel-header-text">
      <div class="role-tag">● Administrador</div>
      <h2>Nueva Deuda</h2>
      <p>Registra una nueva deuda en el sistema.</p>
    </div>
  </div>

  <!-- FORM -->
  <div class="form-container">

    <form action="/deudas" method="POST">

      <label>Estudiante</label>
      <select name="estudiante_id" required>
        <% estudiantes.forEach(e => { %>
          <option value="<%= e.id %>"><%= e.nombre %></option>
        <% }) %>
      </select>

      <label>Monto</label>
      <input type="number" name="monto" placeholder="Ej: 100000" required>

      <label>Estado</label>
      <select name="estado">
        <option value="pendiente">Pendiente</option>
        <option value="pagado">Pagado</option>
      </select>

      <label>Fecha vencimiento</label>
      <input type="date" name="fecha_vencimiento">

      <button type="submit" class="btn-submit">Guardar</button>

    </form>

  </div>

</div>

<!-- FOOTER -->
<div class="footer-portal">
  <hr>
  <p>© Universidad Técnica Federico Santa María</p>
</div>

</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Gestión de Deudas</title>

  <!-- mismo CSS -->
  <link rel="stylesheet" href="/CSS/paneles.css">

  <style>
    .tabla-container {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .top-actions {
      display: flex;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      background: #1E3A8A;
      color: white;
      padding: 12px;
    }

    td {
      padding: 12px;
      border-bottom: 1px solid #eee;
      text-align: center;
    }

    tr:hover {
      background: #f9fafb;
    }

    .btn {
      background: #1E3A8A;
      color: white;
      padding: 6px 10px;
      border-radius: 6px;
      text-decoration: none;
    }

    .btn-edit {
      background: #16A34A;
      color: white;
      padding: 6px 10px;
      border-radius: 6px;
      text-decoration: none;
    }

    .btn-danger {
      background: #DC2626;
      color: white;
      padding: 6px 10px;
      border-radius: 6px;
      text-decoration: none;
    }

    .badge {
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: bold;
    }

    .pagado {
      background: #DCFCE7;
      color: #166534;
    }

    .pendiente {
      background: #FEE2E2;
      color: #991B1B;
    }
    .acciones {
      display: flex;
      justify-content: center;
      gap: 8px;
    }
    .acciones form {
      margin: 0;
    }    
  </style>
</head>

<body>

<!-- PANEL -->
<div class="topbar-institucional">
  <div class="topbar-content">
    <span class="logo-placeholder">
      <img src="/logo.png" alt="Logo USM"> 
      UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
    </span>

    <div class="topbar-right">
      <% if (usuario.rol === 'admin') { %>
        <a href="/admin">⬅ Volver</a> |
      <% } else if (usuario.rol === 'ejecutivo') { %>
        <a href="/ejecutivo">⬅ Volver</a> |
      <% } %>

    </div>
  </div>
</div>

<!-- CONTENIDO PRINCIPAL -->
<div class="main-container">

  <!-- HEADER L -->
  <div class="panel-header">
    <div class="role-icon">📋</div>
    <div class="panel-header-text">
      <h2>Gestión de Deudas</h2>
      <p>Administra y controla las deudas de los estudiantes.</p>
    </div>
  </div>

  <!-- TABLA -->
  <div class="tabla-container">

    <div class="top-actions">
      <a href="/deudas/nueva" class="btn">+ Nueva Deuda</a>
    </div>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Estudiante</th>
          <th>Monto</th>
          <th>Estado</th>
          <th>Vencimiento</th>
          <th>Acciones</th>
        </tr>
      </thead>

      <tbody>
        <% deudas.forEach(d => { %>
          <tr>
            <td><%= d.id %></td>

            <td><%= d.nombre %></td>

            <td>$<%= Number(d.monto).toLocaleString('es-CL') %></td>

            <td>
              <span class="badge <%= d.estado === 'pagada' ? 'pagado' : 'pendiente' %>">
                <%= d.estado %>
              </span>
            </td>

            <td>
              <%= d.fecha_vencimiento 
                ? new Date(d.fecha_vencimiento).toLocaleDateString('es-CL') 
                : '-' %>
            </td>

            <td class="acciones">

              <a href="/deudas/editar/<%= d.id %>" class="btn-edit">Editar</a>

              <% if (usuario.rol === 'admin', 'ejecutivo') { %>
                <form action="/deudas/eliminar/<%= d.id %>" method="POST">
                  <button class="btn-danger">Eliminar</button>
                </form>
              <% } %>

            </td>
          </tr>
        <% }) %>
      </tbody>

    </table>

  </div>

</div>


<div class="footer-portal">
  <hr>
  <p>© Universidad Técnica Federico Santa María</p>
</div>

</body>
</html>

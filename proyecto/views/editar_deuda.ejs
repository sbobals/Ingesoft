<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Deuda</title>

  <!-- MISMO CSS DEL SISTEMA -->
  <link rel="stylesheet" href="/CSS/paneles.css">

  <style>
    .form-container {
      max-width: 500px;
      margin: 0 auto;
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    label {
      display: block;
      margin-top: 15px;
      font-weight: bold;
    }

    input, select {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    .btn-submit {
      margin-top: 20px;
      width: 100%;
      padding: 12px;
      background: #16A34A;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
    }

    .btn-submit:hover {
      background: #15803d;
    }
  </style>
</head>

<body>

<!-- 🔵 TOPBAR -->
<div class="topbar-institucional">
  <div class="topbar-content">
    <span class="logo-placeholder">
      <img src="/logo.png" alt="Logo USM"> 
      UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
    </span>

    <div class="topbar-right">
      <a href="/deudas">⬅ Volver</a> |
      <a href="/logout">🔒 Salir</a> |
      <a href="#">❓ Ayuda</a>
    </div>
  </div>
</div>

<!-- CONTENIDO -->
<div class="main-container">

  <!-- HEADER -->
  <div class="panel-header">
    <div class="role-icon">✏️</div>
    <div class="panel-header-text">
      <div class="role-tag">● Administrador</div>
      <h2>Editar Deuda</h2>
      <p>Modifica los datos de la deuda seleccionada.</p>
    </div>
  </div>

  <!-- FORM -->
  <div class="form-container">

    <form action="/deudas/editar/<%= deuda.id %>" method="POST">

      <label>Monto</label>
      <input type="number" name="monto" value="<%= deuda.monto %>" required>

      <label>Estado</label>
      <select name="estado">
        <option value="pendiente" <%= deuda.estado === 'pendiente' ? 'selected' : '' %>>
          Pendiente
        </option>
        <option value="pagado" <%= deuda.estado === 'pagado' ? 'selected' : '' %>>
          Pagado
        </option>
      </select>

      <label>Fecha vencimiento</label>
      <input 
        type="date" 
        name="fecha_vencimiento"
        value="<%= deuda.fecha_vencimiento ? new Date(deuda.fecha_vencimiento).toISOString().split('T')[0] : '' %>"
      >

      <button type="submit" class="btn-submit">Actualizar</button>

    </form>

  </div>

</div>

<!-- FOOTER -->
<div class="footer-portal">
  <hr>
  <p>© Universidad Técnica Federico Santa María</p>
</div>

</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Estudiante — UTFSM</title>
    <link rel="stylesheet" href="/CSS/paneles.css">
    <link rel="stylesheet" href="/CSS/certificados.css">
    <style>
        .role-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: #1B6B3A;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }
    </style>
</head>
<body>

    <div class="topbar-institucional">
        <div class="topbar-content">
            <span class="logo-placeholder"><img src="/logo.png" alt="Logo USM"> UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA</span>
            <div class="topbar-right">
                <a href="/mis-solicitudes">🔔 Mis Solicitudes</a> &nbsp;|&nbsp;
                <a href="/perfil">👤 Mi Perfil</a> &nbsp;|&nbsp;
                <a href="/logout">🔒 Salir</a> &nbsp;|&nbsp;  
                <a href="#" onclick="window.open('/ayuda.png', 'ayuda', 'width=800,height=600,resizable=yes,scrollbars=yes')">❓ Ayuda</a>
            </div>
        </div>
    </div>

    <div class="main-container">

        <div class="panel-header">
            <div class="role-icon">🎓</div>
            <div class="panel-header-text">
                <div class="role-tag">● Estudiante</div>
                <h2>Bienvenido/a, <%= usuario.nombre %></h2>
                <p>Portal de autoservicio estudiantil — información financiera personal.</p>
            </div>
        </div>

        <%
            const listaNotif = typeof notificacionesResolucion !== 'undefined' ? notificacionesResolucion : [];
        %>
        <% if (listaNotif.length > 0) { %>
            <div class="notificaciones-estudiante-box">
                <div class="notificaciones-estudiante-header">
                    <span>🔔 Notificaciones de Resolución de Certificados (<%= listaNotif.length %>)</span>
                    <a href="/mis-solicitudes" class="link-ver-todas">Ver todas mis solicitudes →</a>
                </div>
                <% listaNotif.forEach(function(sol) { %>
                    <% if (sol.estado === 'APROBADA') { %>
                        <div class="notificacion-resolucion aprobada">
                            <div class="notif-res-texto">
                                <strong>Solicitud #<%= sol.id %> (<%= sol.tipo_certificado %>):</strong>
                                Su solicitud de certificado ha sido APROBADA y está disponible para descarga
                            </div>
                            <a href="/certificados/descargar/<%= sol.id %>" class="btn-descargar-pdf">
                                ⬇ Descargar Certificado PDF
                            </a>
                        </div>
                    <% } else if (sol.estado === 'RECHAZADA') { %>
                        <div class="notificacion-resolucion rechazada">
                            <div class="notif-res-texto">
                                <strong>Solicitud #<%= sol.id %> (<%= sol.tipo_certificado %>):</strong>
                                Su solicitud ha sido RECHAZADA. Motivo: <%= sol.observacion || 'Sin observación especificada' %>
                            </div>
                        </div>
                    <% } %>
                <% }); %>
            </div>
        <% } %>

        <div class="estado-card">
            <div class="estado-info">
                <h3>Estado de cuenta</h3>
                <div class="estado-rut">
                    Usuario: <%= usuario.nombre %>
                </div>
            </div>
            <% if (saldoPendiente > 0) { %>
                <div class="estado-badge alerta">
                    ⚠ Saldo pendiente:
                    $<%= saldoPendiente.toLocaleString('es-CL') %>
                </div>
            <% } else { %>
                <div class="estado-badge">
                    ✓ Sin saldo pendiente
                </div>
            <% } %>
        </div>

        <div class="menu-horizontal">

            <div class="menu-item">
                <div class="menu-item-icon">💳</div>
                <a href="/mi-resumen" class="btn-portal">Mi Resumen Financiero</a>
                <p class="desc-portal">Revisa tus deudas, cargos y saldos actuales.</p>
            </div>

            <div class="menu-item">
                <div class="menu-item-icon">🎁</div>
                <a href="/mis-beneficios" class="btn-portal">Mis Beneficios</a>
                <p class="desc-portal">Consulta el estado de tus becas, créditos y asignaciones.</p>
            </div>

            <div class="menu-item">
                <div class="menu-item-icon">🗂️</div>
                <a href="/mi-historial" class="btn-portal">Mi Historial Financiero</a>
                <p class="desc-portal">Revisa el registro histórico de tus pagos y matrículas.</p>
            </div>

            <div class="menu-item">
                <div class="menu-item-icon">📢</div>
                <a href="/beneficios" class="btn-portal">Simulador de Beneficios</a>
                <p class="desc-portal">Simula becas y créditos estudiantiles activos.</p>
            </div>
            <div class="menu-item">
                <div class="menu-item-icon">📄</div>
                <a href="/certificados" class="btn-portal">
                    Solicitar Certificados
                </a>
                <p class="desc-portal">
                    Envía nuevas solicitudes de certificados indicando tipo y motivo.
                </p>
                <a href="/mis-solicitudes" class="item-arrow student" style="text-decoration: none;">
                    📋 Ver estado de mis solicitudes →
                </a>
            </div>
            <div class="menu-item">
                <div class="menu-item-icon">💳</div>

                <a href="/pago_online" class="btn-portal">
                    Pago en Línea
                </a>

                <p class="desc-portal">
                    Simula el pago de deudas pendientes.
                </p>
            </div>

        </div>

    </div>

    <div class="footer-portal">
        <hr>
        <p>© Universidad Técnica Federico Santa María</p>
    </div>

</body>
</html>

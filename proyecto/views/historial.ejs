<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Historial Estudiante</title>
  <link rel="stylesheet" href="/CSS/historial.css">
</head>

<body>

 <!-- TOPBAR -->
  <div class="topbar">
    <div>
      <div class="topbar-title">Historial Financiero Personal</div>
      <div class="topbar-sub">Sistema Financiero Estudiantil</div>
    </div>
    <a href="/" class="btn-back">&#8592; Volver al inicio</a>
  </div>


<div class="content">  
  <!-- FILTRO -->
    <form method="GET" action="/historial" class="filter-bar">
      <label>Periodo: </label>
      <input type="number" id="year" name="year" min="1900" max="2099" step="1" value="2024">
      <label>Semestre: </label>
      <input type="number" id="semester" name="semester" min="1" max="2" step="1" value="1">
      <button type="submit" class="btn-filter">Filtrar</button>
    </form>
    
    <div class="filter-bar">
      <%
        function InsertSemester(Semester, Deuda, Pagos, Beneficios){
          %>
          <tr>
            <td><%= Semester%></td>
              <td class="text-right monto-deuda"> $<%= Deuda%></td>
              <td class="text-right monto-pagos"> $<%= Pagos%></td>
              <td class="text-right monto-beneficios"> $<%= Beneficios%></td>
            </tr> 
          <%
        }
      %>
      
      <table>
  <thead>
    <tr>
      <th>Semestre</th>
      <th class="text-right">Deuda</th>
      <th class="text-right">Pagos</th>
      <th class="text-right">Beneficios</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>2025-1</td>
      <td class="text-right monto-deuda">$150.000</td>
      <td class="text-right monto-pagos">$150.000</td>
      <td class="text-right monto-beneficios">$30.000</td>
    </tr>
    <%InsertSemester("2024", "224", "", "")%>
    <%InsertSemester("224", "", "")%>
    <%InsertSemester("224", "", "")%>
  </tbody>
  
</table>
      
    </div>
</div>

</body>

</html>

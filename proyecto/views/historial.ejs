<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Historial Estudiante</title>
  <link rel="stylesheet" href="/CSS/historial.css">
</head>

<body>

 <!-- TOPBAR -->
  <div class="topbar">
    <div>
      <div class="topbar-title">Historial Financiero Personal</div>
      <div class="topbar-sub">Sistema Financiero Estudiantil</div>
    </div>
    <a href="/" class="btn-back">&#8592; Volver al inicio</a>
  </div>


<div class="content">  
  <!-- FILTRO -->
    <form method="GET" action="/historial" class="filter-bar">
      <label>Periodo: </label>
      <input type="number" id="year" name="year" min="1900" max="2099" step="1" value="2024">
      <label>Semestre: </label>
      <input type="number" id="semester" name="semester" min="1" max="2" step="1" value="1">
      <button type="submit" class="btn-filter">Filtrar</button>
    </form>
    
    <%Hola("224", "", "")%>
    <div class="filter-bar">
      <%
        function Hola(Deuda, Pagos, Beneficios){
          %>
            <label><%= Deuda%></label> 
          <%
        }
      %>
      
      <table style="width: 100%">
        <tr>
            <th>Semestre</th>
            <th>Deuda</th>
            <th>Pagos</th>
            <th>Beneficios</th>
        </tr>
      </table>
      
    </div>
</div>

</body>

</html>

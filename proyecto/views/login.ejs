<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión — UTFSM</title>
    <link rel="stylesheet" href="/CSS/login.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
</head>
<body>

    <div class="login-wrapper">

        <!-- Panel izquierdo: formulario -->
        <div class="login-panel">

            <div>
                <div class="brand">
                    <div class="brand-icon"><img src="/logo.png" alt="Logo USM"></div>
                    <div class="brand-name">UTFSM</div>
                </div>

                <h1 class="login-welcome">Bienvenido/a</h1>
                <p class="login-subtitle">Portal Autoservicio</p>

                <% if (typeof error !== 'undefined') { %>
                <div class="login-error">
                    <i class="ti ti-alert-circle"></i> <%= error %>
                </div>
                <% } %>

                <form action="/login" method="POST">

                    <div class="input-row">
                        <i class="ti ti-user input-icon"></i>
                        <input
                            type="email"
                            name="email"
                            placeholder="Correo"
                            required
                        >
                    </div>

                    <div class="input-row">
                        <i class="ti ti-lock input-icon"></i>
                        <input
                            type="password"
                            name="password"
                            placeholder="Contraseña"
                            required
                        >
                    </div>

                    <button type="submit">INGRESAR</button>

                </form>
            </div>

            <div class="panel-footer">
                © Universidad Técnica Federico Santa María
            </div>

        </div>

        <!-- Panel derecho: imagen -->
        <div class="login-image">
            <img
                src="https://usm.cl/wp-content/uploads/2021/07/San-Joaquin.jpg"
                alt="Campus universitario UTFSM"
            >
            <div class="login-image-overlay"></div>
        </div>

    </div>

</body>
</html>

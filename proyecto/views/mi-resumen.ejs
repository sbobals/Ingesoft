<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Estado Financiero</title>
    <link rel="stylesheet" href="CSS/paneles.css">
    <link rel="stylesheet" href="CSS/mi-resumen.css">
</head>

<body>

    <!-- TOPBAR -->
    <div class="topbar-institucional">
        <div class="topbar-content">

            <span class="logo-placeholder">
                <img src="/logo.png" alt="UTFSM">
                 UNIVERSIDAD TÉCNICA FEDERICO SANTA MARÍA
            </span>

            <div class="topbar-right">
                <a href="/" class="btn-back">&#8592; Volver al menú</a>
            </div>

        </div>
    </div>

    <!-- CONTENIDO -->
    <div class="main-container">

        <!-- CABECERA -->
        <div class="panel-header">

            <div class="role-icon student">
                🎓
            </div>

            <div class="panel-header-text">

                <div class="role-tag student">
                    ESTUDIANTE
                </div>

                <h2>
                    Mi Estado Financiero
                </h2>

                <p>
                    Bienvenido(a), <strong><%= estudiante.nombre %></strong>.
                    Aquí puedes consultar tu situación financiera actual.
                </p>

            </div>

        </div>

        <!-- TARJETAS RESUMEN (Criterio 1) -->
        <div class="dashboard-grid">

            <div class="finance-card deuda-card">

                <div class="finance-icon">💸</div>

                <h3>Deudas</h3>

                <div class="finance-value">
                    $<%= Number(estudiante.deuda).toLocaleString('es-CL') %>
                </div>

                <p>
                    Total de deudas registradas en el sistema.
                </p>

            </div>

            <div class="finance-card pago-card">

                <div class="finance-icon">💰</div>

                <h3>Pagos Realizados</h3>

                <div class="finance-value">
                    $<%= Number(estudiante.pagos).toLocaleString('es-CL') %>
                </div>

                <p>
                    Total de pagos efectuados.
                </p>

            </div>

            <div class="finance-card beneficio-card">

                <div class="finance-icon">🎓</div>

                <h3>Beneficios</h3>

                <div class="finance-value">
                    $<%= Number(estudiante.beneficios).toLocaleString('es-CL') %>
                </div>

                <p>
                    Becas y beneficios aplicados.
                </p>

            </div>

        </div>

        <!-- SALDO PENDIENTE -->
        <div class="saldo-principal">

            <span class="saldo-label">
                Estado Financiero Actual
            </span>

            <div class="saldo-monto <%= Number(estudiante.saldo_pendiente) > 0 ? 'saldo-rojo' : 'saldo-verde' %>">
                $<%= Math.abs(Number(estudiante.saldo_pendiente)).toLocaleString('es-CL') %>
            </div>

            <p>
                <% if (Number(estudiante.saldo_pendiente) > 0) { %>
                    Mantienes un saldo pendiente por regularizar.
                <% } else { %>
                    No registras deuda pendiente.
                <% } %>
            </p>

            <!-- Barra de progreso de pago -->
            <%
                const deudaTotal = Number(estudiante?.deuda || 0);
                const cubierto = Number(estudiante?.pagos || 0) + Number(estudiante?.beneficios || 0);

                const porcentaje = deudaTotal > 0
                    ? Math.min(100, Math.round((cubierto / deudaTotal) * 100))
                    : 100;
            %>
            <div class="progreso-pago">
                <div class="progreso-info">
                    <span>Cobertura de tu arancel</span>
                    <span class="progreso-porcentaje"><%= porcentaje %>%</span>
                </div>

                <div class="progreso-barra">
                    <div class="progreso-relleno" data-porcentaje="<%= porcentaje %>"></div>
                </div>
            
                <div class="progreso-detalle">
                    <span>💰 Pagado + 🎓 Beneficios: $<%= cubierto.toLocaleString('es-CL') %></span>
                    <span>Total adeudado: $<%= deudaTotal.toLocaleString('es-CL') %></span>
                </div>
            </div>

            <% if (Number(estudiante.saldo_pendiente) > 0) { %>
                <a href="/pago_online" class="btn-pagar-ahora">
                    💳 Pagar saldo pendiente
                </a>
            <% } %>

        </div>

        <!-- ═══════════════════════════════════════════════
             DETALLE DE MIS DEUDAS
        ════════════════════════════════════════════════ -->
        <div class="historial-section">

            <div class="historial-header">
                <h3 class="historial-titulo">
                    📋 Mis Deudas
                </h3>
            </div>

            <% if (deudas.length === 0) { %>

                <div class="historial-vacio">
                    <span class="vacio-icono">✅</span>
                    <p>No tienes deudas registradas.</p>
                </div>

            <% } else { %>

                <div class="tabla-wrapper">
                    <table class="tabla-pagos">

                        <thead>
                            <tr>
                                <th>N° Deuda</th>
                                <th>Monto</th>
                                <th>Vencimiento</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            <% deudas.forEach(function(d) { %>
                            <tr>
                                <td class="pago-id">#<%= d.id %></td>
                                <td class="monto-celda">
                                    $<%= Number(d.monto).toLocaleString('es-CL') %>
                                </td>
                                <td>
                                    <%= d.fecha_vencimiento
                                        ? new Date(d.fecha_vencimiento).toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric' })
                                        : '—' %>
                                </td>
                                <td>
                                    <span class="badge-estado badge-<%= (d.estado || 'sin-estado').toLowerCase().replace(/\s+/g, '-') %>">
                                        <%= d.estado || '—' %>
                                    </span>
                                </td>
                                <td>
                                    <% if (d.estado === 'pendiente') { %>
                                        <a href="/pago_online" class="link-pagar">Pagar →</a>
                                    <% } %>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>

                    </table>
                </div>

            <% } %>

        </div>
        <!-- FIN DETALLE DEUDAS -->

        <!-- ═══════════════════════════════════════════════
             HISTORIAL DE PAGOS POR PERIODO (Criterio 2)
        ════════════════════════════════════════════════ -->
        <div class="historial-section">

            <div class="historial-header">

                <h3 class="historial-titulo">
                    🗂️ Historial de Pagos
                </h3>

                <!-- Filtro de periodo -->
                <form class="periodo-form" method="GET" action="/mi-resumen">

                    <div class="periodo-fields">

                        <div class="campo-periodo">
                            <label for="desde">Desde</label>
                            <input
                                type="date"
                                id="desde"
                                name="desde"
                                value="<%= periodo.desde %>"
                            >
                        </div>

                        <div class="campo-periodo">
                            <label for="hasta">Hasta</label>
                            <input
                                type="date"
                                id="hasta"
                                name="hasta"
                                value="<%= periodo.hasta %>"
                            >
                        </div>

                        <button type="submit" class="btn-filtrar">
                            Filtrar
                        </button>

                    </div>

                </form>

            </div>

            <!-- Tabla de pagos -->
            <% if (historialPagos.length === 0) { %>

                <div class="historial-vacio">
                    <span class="vacio-icono">📭</span>
                    <p>No hay pagos registrados en el período seleccionado.</p>
                    <p class="vacio-sugerencia">Prueba ajustando el rango de fechas.</p>
                </div>

            <% } else { %>

                <div class="tabla-wrapper">
                    <table class="tabla-pagos">

                        <thead>
                            <tr>
                                <th>N° Pago</th>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th>Deudas cubiertas</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% historialPagos.forEach(function(pago) { %>
                            <tr>

                                <!-- ID del pago -->
                                <td class="pago-id">#<%= pago.id %></td>

                                <!-- Fecha formateada -->
                                <td>
                                    <%= new Date(pago.fecha).toLocaleDateString('es-CL', {
                                        day:   '2-digit',
                                        month: '2-digit',
                                        year:  'numeric'
                                    }) %>
                                </td>

                                <!-- Monto -->
                                <td class="monto-celda">
                                    $<%= Number(pago.monto).toLocaleString('es-CL') %>
                                </td>

                                <!-- Badge de estado -->
                                <td>
                                    <span class="badge-estado badge-<%= (pago.estado || 'sin-estado').toLowerCase().replace(/\s+/g, '-') %>">
                                        <%= pago.estado || '—' %>
                                    </span>
                                </td>

                                <!-- Detalle de deudas que cubre este pago -->
                                <td class="detalles-celda">
                                    <% if (pago.detalles && pago.detalles.length > 0) { %>
                                        <ul class="lista-detalles">
                                            <% pago.detalles.forEach(function(d) { %>
                                            <li>
                                                Deuda #<%= d.deuda_id %>
                                                — $<%= Number(d.monto_aplicado).toLocaleString('es-CL') %>
                                                <% if (d.vencimiento) { %>
                                                    <span class="vencimiento">
                                                        (vence <%= new Date(d.vencimiento).toLocaleDateString('es-CL', {
                                                            day:   '2-digit',
                                                            month: '2-digit',
                                                            year:  'numeric'
                                                        }) %>)
                                                    </span>
                                                <% } %>
                                            </li>
                                            <% }) %>
                                        </ul>
                                    <% } else { %>
                                        <span class="sin-detalle">Sin desglose</span>
                                    <% } %>
                                </td>

                            </tr>
                            <% }) %>
                        </tbody>

                        <!-- Totalizador del periodo filtrado -->
                        <tfoot>
                            <tr class="fila-total">
                                <td colspan="2">Total del período</td>
                                <td class="monto-celda">
                                    $<%=
                                        historialPagos
                                            .reduce(function(acc, p) { return acc + Number(p.monto); }, 0)
                                            .toLocaleString('es-CL')
                                    %>
                                </td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>

                    </table>
                </div>

            <% } %>

        </div>
        <!-- FIN HISTORIAL -->

        <!-- ACCIONES -->
        <div class="acciones">

            <a href="/mis-beneficios" class="action-btn">
                🎓 Mis Beneficios
            </a>
            <a href="/" class="action-btn">
                ← Volver atrás
            </a>

        </div>

    </div>

    <!-- FOOTER -->
    <div class="footer-portal">

        <hr>

        <p>
            © Universidad Técnica Federico Santa María
        </p>

        <p>
            Sistema de Gestión Financiera Estudiantil
        </p>

    </div>

</body>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".progreso-relleno").forEach(el => {
            const p = el.dataset.porcentaje || 0;
            el.style.width = p + "%";
        });
    });
</script>
</html>

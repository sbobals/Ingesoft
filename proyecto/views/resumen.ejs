<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Financiero</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #F1F5F9;
      color: #111827;
      min-height: 100vh;
    }

    /* ── TOPBAR ── */
    .topbar {
      background: #1E3A8A;
      padding: 0 2rem;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .topbar-title {
      color: #fff;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: -0.3px;
    }
    .topbar-sub {
      color: rgba(255,255,255,0.55);
      font-size: 13px;
      margin-top: 2px;
    }
    .btn-back {
      color: rgba(255,255,255,0.75);
      text-decoration: none;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.15s;
    }
    .btn-back:hover { color: #fff; }

    /* ── CONTENT ── */
    .content {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* ── FILTRO ── */
    .filter-bar {
      background: #fff;
      border: 1px solid #E5E7EB;
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    .filter-bar label {
      font-size: 13px;
      color: #6B7280;
      font-weight: 500;
    }
    .filter-bar input[type="date"] {
      border: 1px solid #E5E7EB;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 13px;
      color: #111827;
      background: #F9FAFB;
      outline: none;
      transition: border-color 0.15s;
    }
    .filter-bar input[type="date"]:focus { border-color: #1E3A8A; }
    .btn-filter {
      background: #1E3A8A;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 7px 18px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-filter:hover { background: #1e40af; }
    .btn-pdf-global {
      margin-left: auto;
      background: #fff;
      color: #1E3A8A;
      border: 1px solid #1E3A8A;
      border-radius: 8px;
      padding: 7px 18px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 0.15s;
    }
    .btn-pdf-global:hover { background: #EEF2FF; }

    /* ── MÉTRICAS GLOBALES ── */
    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .metric-card {
      background: #fff;
      border: 1px solid #E5E7EB;
      border-radius: 12px;
      padding: 1.25rem;
      border-top: 3px solid transparent;
    }
    .metric-card.danger  { border-top-color: #DC2626; }
    .metric-card.success { border-top-color: #16A34A; }
    .metric-card.purple  { border-top-color: #7C3AED; }
    .metric-card.neutral { border-top-color: #1E3A8A; }
    .metric-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #6B7280;
      margin-bottom: 8px;
    }
    .metric-value {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }
    .metric-value.danger  { color: #DC2626; }
    .metric-value.success { color: #16A34A; }
    .metric-value.purple  { color: #7C3AED; }
    .metric-value.neutral { color: #1E3A8A; }

    /* ── SECCIÓN TÍTULO ── */
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .section-title {
      font-size: 16px;
      font-weight: 600;
      color: #111827;
    }
    .badge-count {
      background: #EEF2FF;
      color: #1E3A8A;
      font-size: 12px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
    }

    /* ── CARDS ESTUDIANTES ── */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
    }
    .card {
      background: #fff;
      border: 1px solid #E5E7EB;
      border-radius: 12px;
      overflow: hidden;
      transition: box-shadow 0.2s;
    }
    .card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); }
    .card-header {
      padding: 1rem 1.25rem 0.75rem;
      border-bottom: 1px solid #F3F4F6;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #EEF2FF;
      color: #1E3A8A;
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      text-transform: uppercase;
    }
    .card-nombre {
      font-size: 15px;
      font-weight: 600;
      color: #111827;
    }
    .card-body {
      padding: 1rem 1.25rem;
    }
    .card-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      font-size: 13px;
      border-bottom: 1px solid #F9FAFB;
    }
    .card-row:last-of-type { border-bottom: none; }
    .card-row-label {
      color: #6B7280;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .dot.danger  { background: #DC2626; }
    .dot.success { background: #16A34A; }
    .dot.purple  { background: #7C3AED; }
    .card-row-value { font-weight: 600; color: #111827; }
    .card-saldo {
      margin-top: 12px;
      padding: 10px 14px;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
    }
    .card-saldo.pendiente { background: #FEF2F2; color: #DC2626; }
    .card-saldo.favor     { background: #F0FDF4; color: #16A34A; }
    .card-footer {
      padding: 0.75rem 1.25rem;
      border-top: 1px solid #F3F4F6;
    }
    .btn-pdf {
      width: 100%;
      display: block;
      text-align: center;
      background: #F9FAFB;
      color: #1E3A8A;
      border: 1px solid #E5E7EB;
      border-radius: 8px;
      padding: 8px;
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      transition: background 0.15s;
    }
    .btn-pdf:hover { background: #EEF2FF; border-color: #1E3A8A; }

    /* ── EMPTY STATE ── */
    .empty {
      text-align: center;
      padding: 3rem;
      color: #9CA3AF;
      font-size: 14px;
    }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="topbar">
    <div>
      <div class="topbar-title">Dashboard Financiero</div>
      <div class="topbar-sub">Sistema Financiero Estudiantil</div>
    </div>
    <a href="/" class="btn-back">&#8592; Volver al inicio</a>
  </div>

  <div class="content">

    <!-- FILTRO -->
    <form method="GET" action="/resumen" class="filter-bar">
      <label>Desde</label>
      <input type="date" name="inicio" value="<%= inicio %>">
      <label>Hasta</label>
      <input type="date" name="fin" value="<%= fin %>">
      <button type="submit" class="btn-filter">Filtrar</button>
      
        <a href="/reporte-global?inicio=<%= inicio %>&fin=<%= fin %>"
        target="_blank"
        class="btn-pdf-global"
      >
        &#128196; PDF Global
      </a>
    </form>

    <!-- MÉTRICAS GLOBALES -->
    <div class="metrics">

      <div class="metric-card danger">
        <div class="metric-label">Total Deudas</div>
        <div class="metric-value danger">
          $<%= Number(totalDeuda).toLocaleString('es-CL') %>
        </div>
      </div>

      <div class="metric-card success">
        <div class="metric-label">Total Pagos</div>
        <div class="metric-value success">
          $<%= Number(totalPagos).toLocaleString('es-CL') %>
        </div>
      </div>

      <div class="metric-card purple">
        <div class="metric-label">Total Beneficios</div>
        <div class="metric-value purple">
          $<%= Number(totalBeneficios).toLocaleString('es-CL') %>
        </div>
      </div>

      <div class="metric-card neutral">
        <div class="metric-label">Saldo Global</div>
        <div class="metric-value <%= saldoGlobal > 0 ? 'danger' : 'success' %>">
          $<%= Math.abs(Number(saldoGlobal)).toLocaleString('es-CL') %>
          <span style="font-size:13px; font-weight:400; margin-left:4px;">
            <%= saldoGlobal > 0 ? 'pendiente' : 'a favor' %>
          </span>
        </div>
      </div>

    </div>

    <!-- HEADER SECCIÓN -->
    <div class="section-header">
      <span class="section-title">Estudiantes</span>
      <span class="badge-count"><%= estudiantes.length %> registros</span>
    </div>

    <!-- CARDS -->
    <% if (estudiantes.length === 0) { %>
      <div class="empty">No hay estudiantes en el período seleccionado.</div>
    <% } else { %>
      <div class="grid">
        <% estudiantes.forEach(r => {
          const saldo = Number(r.deuda) - Number(r.pagos) - Number(r.beneficios);
          const iniciales = r.nombre.split(' ').map(w => w[0]).slice(0,2).join('');
        %>
          <div class="card">

            <div class="card-header">
              <div class="avatar"><%= iniciales %></div>
              <div class="card-nombre"><%= r.nombre %></div>
            </div>

            <div class="card-body">

              <div class="card-row">
                <span class="card-row-label">
                  <span class="dot danger"></span> Deuda
                </span>
                <span class="card-row-value">
                  $<%= Number(r.deuda).toLocaleString('es-CL') %>
                </span>
              </div>

              <div class="card-row">
                <span class="card-row-label">
                  <span class="dot success"></span> Pagos
                </span>
                <span class="card-row-value">
                  $<%= Number(r.pagos).toLocaleString('es-CL') %>
                </span>
              </div>

              <div class="card-row">
                <span class="card-row-label">
                  <span class="dot purple"></span> Beneficios
                </span>
                <span class="card-row-value">
                  $<%= Number(r.beneficios).toLocaleString('es-CL') %>
                </span>
              </div>

              <div class="card-saldo <%= saldo > 0 ? 'pendiente' : 'favor' %>">
                <span><%= saldo > 0 ? 'Saldo pendiente' : 'Saldo a favor' %></span>
                <span>$<%= Math.abs(saldo).toLocaleString('es-CL') %></span>
              </div>

            </div>

            <div class="card-footer">
              
             <a href="/reporte/<%= r.id %>?inicio=<%= inicio %>&fin=<%= fin %>"
                target="_blank"
                class="btn-pdf"
              >
                &#128196; Descargar PDF
              </a>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>

  </div>

</body>
</html>